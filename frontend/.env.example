# ==============================================================================
# SettleCart Marketplace - Frontend Environment Variables Example
# ==============================================================================
# Copy this file to .env.local for local development.
# Do NOT put real credentials, production secrets, or private tokens in this file.
# Note: Variables prefixed with NEXT_PUBLIC_ are exposed to the client-side browser.
# ==============================================================================

# Canonical URL of the frontend application
NEXT_PUBLIC_APP_URL=https://settle-cart.vercel.app

# Optional: External Backend API Base URL (if decoupled from Next.js API routes)
NEXT_PUBLIC_API_URL=
