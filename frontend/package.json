{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --import jiti/register --test --test-force-exit tests/api/*.test.ts",
    "test:api": "node --import jiti/register --test --test-force-exit tests/api/*.test.ts",
    "schema:export": "docker exec backend-api-1 python -m app.scripts.export_openapi --output /app/openapi.json && cp ../backend/openapi.json openapi.json",
    "schema:generate": "openapi-typescript openapi.json -o src/lib/api/schema.d.ts",
    "schema:sync": "npm run schema:export && npm run schema:generate"
  },
  "dependencies": {
    "aos": "^2.3.4",
    "canvas-confetti": "^1.9.4",
    "font-awesome": "^4.7.0",
    "lucide-react": "^1.47.0",
    "next": "16.3.6",
    "openapi-fetch": "^0.17.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/aos": "^3.0.8",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
