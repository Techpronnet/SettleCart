# ==============================================================================
# SettleCart Backend - Environment Variables Template
# Copy this file to .env on your local machine or production EC2 server.
# NEVER commit the real .env containing production secrets to version control.
# ==============================================================================

# --- Application Configuration ---
APP_NAME=SettleCart
APP_ENV=production                       # Set to "production" on EC2, "development" locally
DEBUG=false                              # Strictly false in production
SECRET_KEY=change-this-to-a-secure-random-64-char-string-in-production
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=["https://settle-cart.vercel.app","https://settlecart.com"]
ADMIN_REGISTRATION_SECRET=change-this-admin-secret-in-production

# --- ASGI Concurrency & Worker Tuning ---
# 2 to 4 workers recommended for t3.small / t3.medium (2 * CPU cores + 1)
WEB_CONCURRENCY=2

# --- Database (Neon Serverless PostgreSQL) ---
# Format: postgresql+asyncpg://USER:PASSWORD@HOST/DATABASE?sslmode=require
# Always use Neon's connection pooler endpoint (host ends with -pooler) for serverless scalability.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@ep-settlecart-123456-pooler.us-east-2.aws.neon.tech/settlecart?sslmode=require

# Database Connection Pool Tuning (Neon Serverless Optimized)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE=300                      # Recycles connections every 5 min to prevent serverless idle timeouts
DB_POOL_TIMEOUT=30

# --- Redis & Celery Message Broker ---
# In production on EC2, Redis is networked internally as "redis" (no public port exposure).
# For local development with Docker Compose dev, this uses "redis" as well.
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- JWT Authentication ---
JWT_SECRET_KEY=change-this-jwt-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Host / Domain & SSL Configuration ---
# If using the raw EC2 Server IP, set SERVER_IP and leave DOMAIN_NAME empty or set to the IP.
SERVER_IP=54.123.45.67                   # Your AWS EC2 Public IPv4 / Elastic IP
DOMAIN_NAME=                             # Leave empty or set to api.settlecart.com once DNS is active
CERTBOT_EMAIL=admin@settlecart.com
CERTBOT_STAGING=0                        # Set to 1 for Let's Encrypt Staging API (rate limit testing)


# --- Payment Gateway (Paystack) ---
PAYSTACK_SECRET_KEY=sk_live_change_me
PAYSTACK_PUBLIC_KEY=pk_live_change_me

# --- Cloud Media Storage (Cloudinary) ---
CLOUDINARY_CLOUD_NAME=change_me
CLOUDINARY_API_KEY=change_me
CLOUDINARY_API_SECRET=change_me

# --- Transactional Email (SMTP) ---
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=change_me
SMTP_TLS=true
EMAILS_FROM_EMAIL=noreply@settlecart.com
EMAILS_FROM_NAME=SettleCart Marketplace

# --- SMS Gateway (Termii) ---
TERMII_API_KEY=change_me
TERMII_SENDER_ID=SettleCart
TERMII_API_URL=https://api.ng.termii.com/api

# --- Rate Limiting ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_REGISTER=10/minute
RATE_LIMIT_VERIFY_DELIVERY=5/minute
RATE_LIMIT_PAYMENT_INIT=10/minute
